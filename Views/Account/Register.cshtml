@model TodoApp.Models.RegisterViewModel
@{
    ViewData["Title"] = "Cont nou";
    Layout = "_Layout";
}

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-header">
            <div class="auth-icon">✓</div>
            <h1 class="auth-title">Cont nou</h1>
            <p class="auth-subtitle">Creeaza-ti un cont gratuit</p>
        </div>

        <form asp-action="Register" method="post" class="auth-form">
            @Html.AntiForgeryToken()

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-error">
                    <span class="alert-icon">✗</span>
                    @Html.ValidationSummary(false)
                </div>
            }

            <div class="form-group">
                <label asp-for="Username" class="form-label">Username</label>
                <input asp-for="Username" class="form-control" placeholder="alege un username" autofocus />
                <span asp-validation-for="Username" class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password" class="form-label">Parola</label>
                <input asp-for="Password" type="password" class="form-control" placeholder="minim 3 caractere" />
                <span asp-validation-for="Password" class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmPassword" class="form-label">Confirma parola</label>
                <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="repeta parola" />
                <span asp-validation-for="ConfirmPassword" class="field-error"></span>
            </div>

            <button type="submit" class="btn btn-primary btn-lg btn-full">Creeaza contul</button>
        </form>

        <div class="auth-footer">
            <p>Ai deja cont? <a asp-controller="Account" asp-action="Login">Conecteaza-te</a></p>
        </div>
    </div>
</div>