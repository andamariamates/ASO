@model TodoItem
@{
    ViewData["Title"] = "Editeaza sarcina";
}

<div class="form-page">
    <div class="form-card">
        <div class="form-header">
            <div>
                <h1 class="form-title">Editeaza sarcina</h1>
                <p class="form-subtitle">ID: #@Model.Id &bull; Creata: @Model.CreatedAt.ToString("dd MMM yyyy")</p>
            </div>
            <a asp-action="Index" class="btn btn-secondary">← Inapoi la lista</a>
        </div>

        <form asp-action="Edit" method="post" class="todo-form">
            @Html.AntiForgeryToken()
            <input asp-for="Id" type="hidden" />
            <input asp-for="CreatedAt" type="hidden" />

            <div class="form-group">
                <label asp-for="Title" class="form-label">
                    Titlu <span class="required">*</span>
                </label>
                <input asp-for="Title" class="form-control" autofocus />
                <span asp-validation-for="Title" class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description" class="form-label">Descriere (optional)</label>
                <textarea asp-for="Description" class="form-control form-textarea" rows="3"></textarea>
                <span asp-validation-for="Description" class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="DueDate" class="form-label">Data limita (optional)</label>
                <input asp-for="DueDate" type="datetime-local" class="form-control" />
                <span asp-validation-for="DueDate" class="field-error"></span>
            </div>

            <div class="form-group">
                <label class="form-label">Status</label>
                <div class="checkbox-group">
                    <label class="checkbox-label">
                        <input asp-for="IsCompleted" type="checkbox" class="checkbox-input" />
                        <span class="checkbox-text">Marcheaza ca completata</span>
                    </label>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary btn-lg">💾 Salveaza modificarile</button>
                <a asp-action="Index" class="btn btn-secondary btn-lg">Anuleaza</a>
            </div>
        </form>
    </div>
</div>