@model TodoItem
@{
    ViewData["Title"] = "Adauga sarcina noua";
}

<div class="form-page">
    <div class="form-card">
        <div class="form-header">
            <h1 class="form-title">Adauga sarcina noua</h1>
            <a asp-action="Index" class="btn btn-secondary">← Inapoi la lista</a>
        </div>

        <form asp-action="Create" method="post" class="todo-form">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label asp-for="Title" class="form-label">
                    Titlu <span class="required">*</span>
                </label>
                <input asp-for="Title" class="form-control"
                       placeholder="Ex: Citeste capitolul 3 din carte" autofocus />
                <span asp-validation-for="Title" class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description" class="form-label">Descriere (optional)</label>
                <textarea asp-for="Description" class="form-control form-textarea"
                          rows="3" placeholder="Adauga detalii suplimentare..."></textarea>
                <span asp-validation-for="Description" class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="DueDate" class="form-label">Data limita (optional)</label>
                <input asp-for="DueDate" type="datetime-local" class="form-control" />
                <span asp-validation-for="DueDate" class="field-error"></span>
                <small class="form-hint">Lasa gol daca nu ai un termen limita</small>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary btn-lg">+ Adauga sarcina</button>
                <a asp-action="Index" class="btn btn-secondary btn-lg">Anuleaza</a>
            </div>
        </form>
    </div>
</div>