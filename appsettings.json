{
  // ============================================================
  //  appsettings.json  ─  CONFIGURATIA APLICATIEI
  //
  //  Setarile de aici pot fi suprascrise de:
  //  - appsettings.Development.json (mediu de dezvoltare)
  //  - Variabile de mediu (Environment Variables)
  //  - Argumente in linia de comanda
  // ============================================================

  "ConnectionStrings": {
    // Fisierul SQLite va fi creat in folderul aplicatiei
    // Pentru SQL Server: "Server=.;Database=TodoDb;Trusted_Connection=True;"
    "DefaultConnection": "Data Source=todo.db"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // Afisam query-urile SQL in consola (util pentru debug/invatare)
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },

  "AllowedHosts": "*"
}